<?xml version="1.0"?>
<package format="3">
  <name>intball2_stereo</name>
  <version>0.1.0</version>
  <description>ROS-independent stereo depth processing and ROS input synchronization and depth publication.</description>
  <maintainer email="sobits@todo.todo">sobits</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>libopencv-dev</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>rmw</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>libgtest-dev</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rcl_yaml_param_parser</test_depend>
  <test_depend>rcutils</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
